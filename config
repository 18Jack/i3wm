# Mod key (tecla Windows)
set $mod Mod4

# Fuente simple
font pango:monospace 11

# Terminal por defecto
set $term lxterminal

# Lanzador
set $menu rofi -show run          

# ── Atajos básicos ──────────────────────────────────
bindsym $mod+Return exec $term
bindsym $mod+s exec $menu
bindsym $mod+Shift+w kill         
bindsym $mod+Shift+e exit
bindsym $mod+Shift+r restart

# ── Foco entre ventanas ──────────────────────────────
bindsym $mod+Left  focus left
bindsym $mod+Dowm focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# ── Mover ventanas ───────────────────────────────────
bindsym $mod+Shift+h move left
bindsym $mod+Shift+n move down
bindsym $mod+Shift+u move up
bindsym $mod+Shift+k move right

# ── Layouts ──────────────────────────────────────────
bindsym $mod+f fullscreen toggle
#bindsym $mod+s layout stacking
#bindsym $mod+w layout tabbed
#bindsym $mod+e layout toggle split
bindsym $mod+v split vertical
bindsym $mod+h split horizontal

# ── Workspaces ───────────────────────────────────────
#Nombres
set $ws1 "1: 🏠 Principal"
set $ws2 "2: 💬 WhatsApp"
set $ws3 "3: 🎵 Spotify"
set $ws4 "4"
set $ws5 "5"
 
bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5

#Bloqueo de la pantalla
bindsym $mod+l exec dm-tool lock
 
# ── Resize mode ──────────────────────────────────────
mode "resize" {
    bindsym Left resize grow width 5 px or 5 ppt
    bindsym Right resize shrink width 5 px or 5 ppt
    bindsym Dowm resize grow height 5 px or 5 ppt
    bindsym Up resize shrink height 5 px or 5 ppt
    bindsym Escape mode "default"
}

bindsym $mod+r mode "resize"

# ── Bordes ─────────────────────────────────────────
gaps outer 1
gaps inner 6
smart_gaps on

for_window [class="^.*"] border pixel 1

# ── Barra de estado(Polybar) ──────────────────────────────────
exec --no-startup-id polybar --config=~/.config/polybar/config.ini main

# ── Autostart ────────────────────────────────────────
set $menu rofi -show drun
exec_always --no-startup-id sleep 2 && setxkbmap latam

exec_always --no-startup-id picom -b -f

exec --no-startup-id flatpak run com.opera.Opera
exec --no-startup-id sleep 5 && flatpak run org.mozilla.firefox --new-window https://web.whatsapp.com
exec --no-startup-id sleep 10 && flatpak run com.spotify.Client

# ── Volumen ─────────────────────────────────────────
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle

# ── Multimedia ───────────────────────────────────────
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous
bindsym XF86AudioStop exec playerctl stop

# Captura pantalla completa al portapapeles
bindsym Print exec --no-startup-id maim | xclip -selection clipboard -t image/png

# Captura de área seleccionada al portapapeles
bindsym $mod+Print exec --no-startup-id maim -s | xclip -selection clipboard -t image/png

#Fondo de pantalla
exec_always --no-startup-id feh --bg-fill "/home/david/Imagenes/FondosEscritorio/montain_vec.jpg"
